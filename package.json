{
  "name": "grafana-mcp-agent",
  "version": "0.1.0",
  "description": "An open-source Grafana app plugin: a chat agent that connects to any MCP server(s) and auto-prefills your question from the page you're viewing.",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "typecheck": "tsc --noEmit",
    "backend:build": "mage -v build:linux",
    "backend:build:all": "GOOS=linux GOARCH=amd64 go build -o dist/gpx_mcpagent_linux_amd64 ./pkg && GOOS=linux GOARCH=arm64 go build -o dist/gpx_mcpagent_linux_arm64 ./pkg",
    "package": "./scripts/package.sh",
    "test": "jest"
  },
  "author": "grafana-mcp-agent contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@swc/core": "^1.16.1",
    "@swc/helpers": "^0.5.23",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "copy-webpack-plugin": "^14.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^13.0.6",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "^13.2.0",
    "@grafana/runtime": "^13.2.0",
    "@grafana/ui": "^13.2.0",
    "framer-motion": "^11.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
